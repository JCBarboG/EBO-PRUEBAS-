+/* ════════════════════════════════════════════════════════════════════
+   EBO · Tema "Mesa de luz" — SOLO PRESENTACIÓN
+   Se importa después de App.css (ver main.jsx) y lo sobrescribe.
+   No cambia ninguna lógica: únicamente colores, tipografía y distribución.
+   Todas las reglas usan el prefijo :root[data-theme] para ganar a las
+   reglas de modo oscuro de App.css; por eso en esta versión de pruebas el
+   aspecto es el mismo con modo claro u oscuro.
+   ════════════════════════════════════════════════════════════════════ */
+
+:root[data-theme] {
+  --navy:      #f2b544;   /* acento principal (ámbar) */
+  --navy-deep: #0f1113;   /* barras y encabezados */
+  --brass:     #f2b544;
+  --green:     #7ee0b0;   /* completado, OCR, Exportar */
+  --paper:     #141619;   /* fondo */
+  --card:      #1a1c20;   /* paneles */
+  --card-2:    #1f2226;
+  --ink:       #ebe7df;
+  --ink-soft:  #9ea3aa;
+  --rule:      #2c3036;
+  --line:      #3a3e45;
+  --danger:    #e58a7a;
+
+  --font-display: 'Libre Caslon Text', Georgia, serif;
+  --font-sans:    'Familjen Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif;
+  --font-mono:    'DM Mono', ui-monospace, Menlo, monospace;
+
+  color-scheme: dark;
+}
+
+:root[data-theme] body { background: var(--paper); color: var(--ink); }
+
+@keyframes mesaScan { 0% { top: 6%; } 50% { top: 92%; } 100% { top: 6%; } }
+@keyframes mesaIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
+@keyframes mesaPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(242,181,68,.5); } 50% { box-shadow: 0 0 0 6px rgba(242,181,68,0); } }
+
+@media (prefers-reduced-motion: reduce) {
+  :root[data-theme] *, :root[data-theme] *::before, :root[data-theme] *::after {
+    animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important;
+  }
+}
+
+/* ── Encabezado: barra delgada, hamburguesa a la izquierda ── */
+:root[data-theme] .app__header { max-width: none; padding: 0; margin: 0; }
+:root[data-theme] .header-banner {
+  margin: 0; border: 0; border-bottom: 1px solid #25282d; border-radius: 0;
+  background: var(--paper); padding: 0 20px; height: 60px; gap: 14px;
+  justify-content: flex-start;
+}
+:root[data-theme] .header-banner .hamburger {
+  order: -1; width: 44px; height: 44px; border: 1px solid #33373d; border-radius: 10px;
+  align-items: center; justify-content: center; gap: 4px; padding: 0;
+}
+:root[data-theme] .hamburger span { width: 18px; height: 1.8px; background: var(--ink) !important; }
+:root[data-theme] .header-brand { flex: none; text-align: left; display: flex; align-items: baseline; gap: 14px; }
+:root[data-theme] .header-banner h1 {
+  font-family: var(--font-sans); font-style: normal; font-weight: 700; font-size: 22px;
+  letter-spacing: .14em; margin: 0; color: var(--ink) !important;
+}
+:root[data-theme] .header-sub { font-size: 11px; letter-spacing: .1em; color: var(--ink-soft) !important; }
+
+/* ── Selector de tipo de documento ── */
+:root[data-theme] .mesa-toolbar { padding: 12px 20px; border-bottom: 1px solid #25282d; }
+:root[data-theme] .doc-type-selector {
+  margin: 0; display: inline-flex; flex-wrap: wrap; gap: 2px; padding: 3px;
+  background: var(--card); border: 1px solid var(--rule); border-radius: 10px;
+}
+:root[data-theme] .doc-type-tab {
+  flex: none; border: 0; border-radius: 7px; padding: 8px 14px; font-size: 13.5px;
+  color: var(--ink-soft); background: transparent; min-height: 36px;
+}
+:root[data-theme] .doc-type-tab--active { background: #2a2d32; color: var(--ink); font-weight: 600; }
+:root[data-theme] .doc-type-tab:hover:not(.doc-type-tab--active) { background: #202328; color: var(--ink); }
+
+/* ── Tarjetas y encabezados de paso ── */
+:root[data-theme] .app { max-width: none; padding: 0; }
+:root[data-theme] .card {
+  background: var(--card); border: 1px solid var(--rule); border-radius: 14px;
+  box-shadow: none; padding: 18px 20px 20px; animation: mesaIn .45s ease-out both;
+}
+:root[data-theme] .step-head { margin-bottom: 12px; gap: 10px; }
+:root[data-theme] .step-num {
+  width: 26px; height: 26px; border-radius: 50%; background: transparent;
+  border: 1.5px solid var(--line); color: var(--ink-soft); font-size: 11.5px;
+}
+:root[data-theme] .step-head h2 { font-family: var(--font-sans); font-size: 16px; font-weight: 600; color: var(--ink); }
+:root[data-theme] .divider { display: none; }
+:root[data-theme] .mesa-count { margin-left: auto; font-family: var(--font-mono); font-size: 12px; color: var(--ink-soft); }
+
+/* ── Botones generales ── */
+:root[data-theme] .btn { border-radius: 10px; font-size: 13.5px; min-height: 44px; }
+:root[data-theme] .btn--primary { background: var(--brass); border-color: var(--brass); color: #1a1406; font-weight: 600; }
+:root[data-theme] .btn--primary:hover:not(:disabled) { background: #ffc85e; border-color: #ffc85e; }
+:root[data-theme] .btn--outline { background: transparent; border-color: var(--line); color: var(--ink); }
+:root[data-theme] .btn--outline:hover:not(:disabled) { border-color: var(--ink-soft); background: #202328; }
+:root[data-theme] .btn--ghost { border-color: var(--rule); color: var(--ink-soft); }
+:root[data-theme] .btn--history { border-color: var(--line); color: var(--ink-soft); }
+:root[data-theme] .btn--danger { color: #1a0f0d; }
+:root[data-theme] .btn--danger-outline { color: var(--danger); border-color: rgba(229,138,122,.45); }
+:root[data-theme] .icon-btn:hover { color: var(--danger); background: rgba(229,138,122,.12); }
+
+/* ── Paso 01: mesa de luz ── */
+:root[data-theme] .mesa__stage { position: relative; overflow: hidden; }
+:root[data-theme] .gallery-container {
+  border: 0; border-radius: 12px; padding: 18px;
+  background: radial-gradient(ellipse at 50% 45%, #2a2c30 0%, #17191c 72%);
+}
+:root[data-theme] .gallery-image { background: transparent; min-height: 260px; max-height: 380px; }
+:root[data-theme] .gallery-image img { max-height: 380px; box-shadow: 0 24px 50px rgba(0,0,0,.55); border-radius: 3px; }
+:root[data-theme] .gallery-placeholder { color: var(--ink-soft); opacity: .7; }
+:root[data-theme] .nav-btn { background: rgba(20,22,25,.85); border-color: #33373d; color: var(--ink); width: 44px; height: 44px; border-radius: 10px; }
+:root[data-theme] .nav-btn:hover:not(:disabled) { border-color: var(--ink-soft); }
+:root[data-theme] .rotate-btn { background: rgba(20,22,25,.85); border: 1px solid #33373d; width: 44px; height: 44px; }
+:root[data-theme] .dot { background: #33373d; }
+:root[data-theme] .dot--used { background: #5a5f66; }
+:root[data-theme] .dot--active { background: var(--brass); }
+:root[data-theme] .image-hint { color: var(--ink-soft); }
+:root[data-theme] .orientation-warning { background: rgba(229,138,122,.1); border-color: var(--danger); color: var(--danger); }
+:root[data-theme] .ocr-progress__bar-track { height: 4px; background: #25282d; }
+:root[data-theme] .ocr-progress__bar-fill { background: var(--green); }
+:root[data-theme] .ocr-progress__label { font-family: var(--font-mono); font-size: 12px; color: var(--green); }
+:root[data-theme] .error-text { color: var(--danger); }
+/* Línea de escaneo: solo se muestra mientras isProcessing es verdadero */
+:root[data-theme] .mesa-scan {
+  position: absolute; left: 0; right: 0; height: 2px; z-index: 3; pointer-events: none;
+  background: var(--green); box-shadow: 0 0 16px 3px rgba(126,224,176,.55);
+  animation: mesaScan 3.2s ease-in-out infinite;
+}
+
+/* ── Paso 02: texto y campos ── */
+:root[data-theme] .text-editor__label, :root[data-theme] .selection-bar__hint { color: var(--ink-soft); font-size: 12.5px; }
+:root[data-theme] .text-editor__area {
+  background: var(--paper); border: 1px solid var(--line); color: var(--ink);
+  font-family: var(--font-mono); font-size: 13px; line-height: 1.7; border-radius: 10px; min-height: 240px;
+}
+:root[data-theme] .text-editor__area::selection { background: rgba(242,181,68,.35); color: #fff; }
+:root[data-theme] .text-editor__area:focus,
+:root[data-theme] .category-grid__item input:focus { border-color: var(--brass); box-shadow: 0 0 0 3px rgba(242,181,68,.15); }
+:root[data-theme] .selection-bar__text { color: var(--brass); }
+:root[data-theme] .fields-scroll { border: 1px solid var(--rule); background: #17191c; border-radius: 10px; }
+:root[data-theme] .category-grid__head label { color: var(--ink); font-size: 11px; }
+:root[data-theme] .category-grid__head:hover label { color: var(--brass); }
+:root[data-theme] .category-grid__tag { font-family: var(--font-mono); font-size: 10.5px; color: var(--brass); }
+:root[data-theme] .category-grid__item input {
+  background: var(--card-2); border: 1px solid var(--line); color: var(--ink);
+  font-family: var(--font-sans); font-size: 14px; border-radius: 8px; min-height: 40px;
+}
+:root[data-theme] .category-grid__item input::placeholder { color: #5f646b; }
+:root[data-theme] .category-grid__item--active input { border-color: var(--green); box-shadow: 0 0 0 3px rgba(126,224,176,.18); }
+:root[data-theme] .category-grid__item--active .category-grid__head label { color: var(--green); }
+/* Con texto seleccionado, los campos vacíos se ven listos para recibirlo */
+:root[data-theme] .category-fields:has(.selection-bar__text) .category-grid__item input:placeholder-shown {
+  border-style: dashed; border-color: rgba(242,181,68,.6); background: rgba(242,181,68,.05);
+}
+:root[data-theme] .chip { color: var(--brass); background: rgba(242,181,68,.08); border-color: rgba(242,181,68,.25); }
+
+/* ── Paso 03: tabla estilo Excel ── */
+:root[data-theme] .status-row { display: none; }          /* contador y vaciar viven en la barra lateral */
+:root[data-theme] .mesa__table .btn-row,
+:root[data-theme] .mesa__table .btn--history { display: none; } /* mismos botones, ahora en la barra lateral */
+:root[data-theme] .excel-wrap { border: 1px solid var(--rule); background: var(--card); border-radius: 10px; }
+:root[data-theme] .excel-table { font-family: var(--font-sans); font-size: 12.5px; }
+:root[data-theme] .excel-table .col-letters th,
+:root[data-theme] .excel-table .field-names th:first-child,
+:root[data-theme] .excel-table tbody td:first-child {
+  background: #1d2024; color: #6f747b; border-color: #2c3036; font-family: var(--font-mono);
+}
+:root[data-theme] .excel-table .field-names th { background: #22252a; color: var(--ink); border-color: #2c3036; letter-spacing: .04em; }
+:root[data-theme] .field-names__tag { font-family: var(--font-mono); color: var(--brass); }
+:root[data-theme] .excel-table tbody td { background: var(--card); color: var(--ink); border-color: #25282d; }
+:root[data-theme] .excel-table tbody tr:nth-child(even) td { background: #1c1f23; }
+:root[data-theme] .excel-table .empty-cell { color: #4a4f57; }
+:root[data-theme] .marc-sym { color: var(--brass); }
+:root[data-theme] .col-punct-corner { border-color: transparent #5a5f66 transparent transparent; }
+:root[data-theme] .col-punct-corner--active { border-color: transparent var(--brass) transparent transparent; }
+:root[data-theme] .table-resize__grip { background: #4a4f57; }
+:root[data-theme] .punct-pop { background: var(--card-2); border-color: var(--line); box-shadow: 0 14px 30px rgba(0,0,0,.5); }
+:root[data-theme] .punct-btn { background: #1b1e22; border-color: #33373d; color: var(--ink); }
+:root[data-theme] .punct-btn--active { background: var(--brass); border-color: var(--brass); color: #1a1406; }
+:root[data-theme] .punct-reset { color: var(--ink); border-color: var(--line); }
+:root[data-theme] .punct-pop__caption { background: rgba(242,181,68,.1); color: var(--ink); }
+
+/* ── Barra lateral: pasos + acciones ── */
+:root[data-theme] .mesa__side { display: flex; flex-direction: column; gap: 22px; }
+:root[data-theme] .mesa-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
+:root[data-theme] .mesa-step { position: relative; padding: 0 0 18px 24px; }
+:root[data-theme] .mesa-step::before {
+  content: ''; position: absolute; left: 0; top: 3px; width: 12px; height: 12px; border-radius: 50%;
+  border: 2px solid #4a4f57; box-sizing: border-box;
+}
+:root[data-theme] .mesa-step::after {
+  content: ''; position: absolute; left: 5px; top: 18px; bottom: 0; width: 2px; background: #33373d;
+}
+:root[data-theme] .mesa-step:last-child::after { display: none; }
+:root[data-theme] .mesa-step a { display: flex; flex-direction: column; gap: 2px; text-decoration: none; color: var(--ink-soft); }
+:root[data-theme] .mesa-step b { font-size: 13.5px; font-weight: 600; }
+:root[data-theme] .mesa-step span { font-family: var(--font-mono); font-size: 11.5px; color: #6f747b; }
+:root[data-theme] .mesa-step.is-done::before { background: var(--green); border-color: var(--green); }
+:root[data-theme] .mesa-step.is-done::after { background: var(--green); }
